{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "shadri-zulkurniadi/family-hub",
    "description": "Family Hub household management application dependencies.",
    "type": "project",
    "require": {
        "php": "~8.5.0",
        "ext-curl": "*",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "blade-ui-kit/blade-heroicons": "^2.7",
        "laravel-notification-channels/webpush": "^13.0.1",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.38",
        "livewire/livewire": "^4.4.8",
        "maatwebsite/excel": "^4.0.6",
        "rlanvin/php-rrule": "^3.0",
        "spatie/icalendar-generator": "^3.3.1",
        "spatie/laravel-activitylog": "^5.1.3",
        "spatie/laravel-backup": "^10.3.3",
        "spatie/laravel-medialibrary": "^11.23.10"
    },
    "require-dev": {
        "larastan/larastan": "^3.13.2",
        "laravel/boost": "^2.10.3",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-laravel": "^5.0.1"
    },
    "autoload": {
        "files": [
            "app/Core/Support/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "@php artisan serve --host=127.0.0.1 --port=8000",
        "test": "@php vendor/bin/pest",
        "lint": "@php vendor/bin/pint --test",
        "analyse": "@php vendor/bin/phpstan analyse --no-progress",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/passkeys"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
